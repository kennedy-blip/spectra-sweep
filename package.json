{
  "name": "spectra-sweep",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SPECTRA-SWEEP \u2014 Optical glint camera scanner, ultrasonic spy-beacon interceptor, EMF bug sweeper and travel privacy auditor.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "cap:sync": "cap sync android",
    "cap:add": "cap add android",
    "apk:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "test": "vitest run",
    "test:watch": "vitest",
    "selftest": "node scripts/selftest.mjs && node scripts/apk-container-check.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/motion": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "dexie": "^4.0.10",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
